<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grammar Fixer"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Clean, human English in one tap"
                    android:textColor="#C7D2FE"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shown only after a crash, so the user can send the error -->
        <LinearLayout android:id="@+id/crashCard" style="@style/Card" android:visibility="gone">
            <TextView style="@style/CardTitle" android:text="The app crashed last time" android:textColor="#DC2626" />
            <TextView
                style="@style/Hint"
                android:text="Please send a screenshot of this, or tap Copy error and send it." />
            <TextView
                android:id="@+id/crashText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:maxLines="14"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:typeface="monospace" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end">
                <Button android:id="@+id/crashDismiss" style="@style/SecondaryButton" android:text="Dismiss" />
                <Button
                    android:id="@+id/crashCopy"
                    style="@style/SecondaryButton"
                    android:layout_marginStart="10dp"
                    android:text="Copy error" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1-tap fix through Gboard's globe key -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="1-tap Fix on Gboard" />
            <TextView
                style="@style/Hint"
                android:text="Type in Gboard like normal, then tap the 🌐 globe key. Your text gets fixed and Gboard comes back by itself." />
            <TextView
                android:id="@+id/quickStatus"
                style="@style/Hint"
                android:layout_marginTop="12dp"
                android:textSize="15sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/quickEnable"
                style="@style/PrimaryButton"
                android:text="1.  Turn on 1-tap Fix" />
            <TextView
                style="@style/Hint"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/ink"
                android:text="2.  Show the globe key in Gboard: open Gboard settings, Preferences, turn on Show language switch key.\n3.  Done. Type, tap 🌐, fixed.\n\nNo globe key? Long-press the space bar and pick Grammar Fixer.\nIf you use Bangla in Gboard too, the globe may go to Bangla first. Tap it once more." />
            <TextView
                style="@style/Hint"
                android:layout_marginTop="12dp"
                android:text="Safe: it only sees the text box you are in, and only while fixing. It can\'t see your screen or press any buttons. Android shows its usual keyboard warning when you turn it on." />
        </LinearLayout>

        <!-- Fallback: the text selection menu -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="Other way" />
            <TextView
                style="@style/Hint"
                android:layout_marginTop="8dp"
                android:text="Select the text, tap the 3 dots, then Fix grammar. Or share any text to Grammar Fixer." />
        </LinearLayout>

        <!-- API key -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="Groq API key" />
            <TextView
                android:id="@+id/getKey"
                style="@style/Hint"
                android:text="Get a free key at console.groq.com/keys"
                android:textColor="@color/accent_dark" />
            <EditText
                android:id="@+id/key"
                style="@style/Input"
                android:hint="gsk_..."
                android:inputType="textPassword"
                android:singleLine="true" />
            <Button
                android:id="@+id/save"
                style="@style/PrimaryButton"
                android:text="Save and test key" />
            <TextView
                android:id="@+id/status"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Style -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="Writing style" />
            <Spinner
                android:id="@+id/tone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp" />
            <TextView android:id="@+id/toneHint" style="@style/Hint" />
            <Switch
                android:id="@+id/translate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Translate Bangla / Banglish to English"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Try it -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="Try it here" />
            <EditText
                android:id="@+id/input"
                style="@style/Input"
                android:gravity="top|start"
                android:hint="Type or paste your text. Banglish works too."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />
            <Button
                android:id="@+id/fix"
                style="@style/PrimaryButton"
                android:text="Fix my text" />
            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/resultActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:visibility="gone">
                <Button android:id="@+id/share" style="@style/SecondaryButton" android:text="Share" />
                <Button
                    android:id="@+id/copy"
                    style="@style/SecondaryButton"
                    android:layout_marginStart="10dp"
                    android:text="Copy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
